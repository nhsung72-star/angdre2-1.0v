# =====================================================================
# Vercel 및 로컬 서버 환경 변수 설정 예시
# 주의: API 키에는 절대 VITE_ 접두사를 붙이지 마세요 (서버 전용 변수).
# =====================================================================

# [필수] Google Gemini API 키 (서버리스 함수 /api/recommend-outfit 에서만 사용)
# Vercel 대시보드 > Settings > Environment Variables 에 등록하세요.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# [선택] 앱의 기본 배포 도메인 (CORS 허용 오리진 추가용, Vercel 배포 시 자동 도메인도 허용됨)
APP_URL="MY_APP_URL"
